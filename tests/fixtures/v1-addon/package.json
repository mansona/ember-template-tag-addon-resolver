{
  "name": "my-silly-v1-addon",
  "version": "0.0.0",
  "description": "The default blueprint for ember-cli addons.",
  "private": true,
  "keywords": [
    "ember-addon"
  ],
  "repository": "",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
