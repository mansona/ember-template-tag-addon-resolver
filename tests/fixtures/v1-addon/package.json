    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-try": "^4.0.0",
    "loader.js": "^4.7.0",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "webpack": "^5.111.0"
  },
  "engines": {
    "node": ">= 20.19"
  },
